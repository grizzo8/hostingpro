{
  "name": "HostingPackage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Package name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "description": {
      "type": "string",
      "description": "Package description"
    },
    "price": {
      "type": "number",
      "description": "Upfront price in USD"
    },
    "daily_price": {
      "type": "number",
      "description": "Daily price equivalent ($)"
    },
    "monthly_price": {
      "type": "number",
      "description": "Monthly billing price (28 days)"
    },
    "daily_payout": {
      "type": "number",
      "description": "Daily payout amount after 3 referrals"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of features"
    },
    "commission_rate": {
      "type": "number",
      "description": "Commission percentage for affiliates"
    },
    "recurring_commission": {
      "type": "boolean",
      "description": "Whether commission is recurring"
    },
    "is_popular": {
      "type": "boolean",
      "description": "Mark as popular/featured"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "price",
    "daily_price",
    "monthly_price",
    "commission_rate"
  ]
}